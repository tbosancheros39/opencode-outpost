{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2-pro",
  "small_model": "opencode-go/minimax-m2.7",
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "[REDACTED]",
        "timeout": 300000
      },
      "models": {
        "glm-5": {
          "name": "GLM-5"
        },
        "glm-5.1": {
          "name": "GLM-5.1"
        },
        "kimi-k2.5": {
          "name": "Kimi-K2.5"
        },
        "kimi-k2.6": {
          "name": "Kimi-K2.6"
        },
        "mimo-v2-omni": {
          "name": "MiMo-V2-Omni"
        },
        "mimo-v2-pro": {
          "name": "MiMo-V2-Pro"
        },
        "minimax-m2.5": {
          "name": "MiniMax-M2.5"
        },
        "minimax-m2.7": {
          "name": "MiniMax-M2.7"
        },
        "qwen-3.6": {
          "name": "Qwen-3.6"
        },
        "qwen3.5-plus": {
          "name": "Qwen3.5-Plus"
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6-Plus"
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "[REDACTED]"
      },
      "models": {
        "inclusionai/ling-2.6-flash:free": {
          "name": "Ling 2.6 Flash (Free)",
          "options": {
            "max_tokens": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": false
    },
    "filesystem-mcp": {
      "type": "local",
      "command": [
        "/home/ismar/Workspace/"
      ],
      "timeout": 30000,
      "enabled": true
    },
    "ddg-search": {
      "type": "local",
      "command": [
        "uvx",
        "--quiet",
        "duckduckgo-mcp-server"
      ],
      "enabled": false
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,deep_search_exa,crawling_exa",
      "headers": {
        "EXA_API_KEY": "[REDACTED]"
      },
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "env",
        "FIRECRAWL_API_KEY=[REDACTED]",
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "[REDACTED]"
      },
      "enabled": false
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context", "ide", "--project-from-cwd"],
      "enabled": true,
      "timeout": 120000
    }
  },
  "permission": {
    "skill": "allow"
  },
  "agent": {
    "explore": {
      "disable": false
    },
    "general": {
      "disable": false
    }
  }
}